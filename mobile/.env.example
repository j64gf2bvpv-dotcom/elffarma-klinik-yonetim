# Supabase projenizin Project Settings > API sayfasından alın — masaüstü .env'deki
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY ile AYNI proje/değerler olmalı.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Uygulama başlığında kullanılacak klinik adı
EXPO_PUBLIC_CLINIC_NAME=Elffarma Paket Programı

# --- AI Altyapısı (opsiyonel, sadece Kartvizit Tarama için) --------------
# Masaüstündeki .env'nin VITE_OPENAI_API_KEY/VITE_GEMINI_API_KEY/
# VITE_ANTHROPIC_API_KEY ile AYNI mantık — Ayarlar > Yapay Zekâ'da (masaüstü)
# seçili sağlayıcıya göre ilgili anahtar burada da tanımlıysa, personelin
# kendi staff_ai_keys kaydı yoksa buna düşer. Personel kendi anahtarını
# girdiyse bu değerler hiç gerekmez.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=
