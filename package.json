{
  "name": "klinik-yonetim",
  "private": true,
  "version": "2.17.150",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "Medikal estetik klinikleri için müşteri, stok, tahsilat ve randevu yönetimi",
  "author": "Elffarma",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepackage": "node scripts/check-release-env.mjs",
    "package": "cross-env ELECTRON_RUN_AS_NODE= npm run build && cross-env ELECTRON_RUN_AS_NODE= electron-builder",
    "predist": "node scripts/check-release-env.mjs",
    "dist": "npm run package",
    "db:status": "supabase migration list --linked",
    "db:migration:new": "supabase migration new",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked"
  },
