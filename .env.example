# Supabase projenizin Project Settings > API sayfasından alın
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Uygulama başlığında ve WhatsApp mesaj şablonlarında kullanılacak klinik adı
VITE_CLINIC_NAME=Elffarma Paket Programı

# --- AI Altyapısı (opsiyonel) -------------------------------------------
# Varsayılan sağlayıcı Ollama'dır ve yerelde (http://localhost:11434) çalıştığı
# için hiçbir değer gerekmez. Ayarlar > Yapay Zekâ ekranından farklı bir
# sağlayıcıya geçilirse, aşağıdaki ilgili API anahtarı burada tanımlı olmalı —
# API anahtarları asla Supabase'e/veritabanına yazılmaz, sadece build zamanında
# bu dosyadan okunur.
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1
VITE_OLLAMA_MODEL=qwen2.5:3b
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_ANTHROPIC_API_KEY=
